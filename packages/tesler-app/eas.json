{
    "cli": {
        "version": ">= 21.0.2",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "distribution": "internal",
            "credentialsSource": "local",
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "autoIncrement": true,
            "credentialsSource": "local",
            "android": {
                "buildType": "app-bundle"
            }
        }
    },
    "submit": {
        "internal": {
            "android": {
                "serviceAccountKeyPath": "./credentials/google-service-account.json",
                "track": "internal",
                "releaseStatus": "completed"
            }
        },
        "production": {
            "android": {
                "serviceAccountKeyPath": "./credentials/google-service-account.json",
                "track": "production",
                "releaseStatus": "completed"
            }
        }
    }
}