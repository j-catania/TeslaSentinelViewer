{
    "name": "tesler-workspace",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "pnpm --filter tesler-desktop run dev",
        "build:core": "pnpm --filter tesler-core run build",
        "build:desktop": "pnpm run build:core && pnpm --filter tesler-desktop run build",
        "build:android": "pnpm run build:core && pnpm --filter tesler-app run build:apk",
        "build:android:aab": "pnpm run build:core && pnpm --filter tesler-app run build:aab",
        "package": "pnpm --filter tesler-desktop run package --",
        "preview": "pnpm --filter tesler-desktop run preview",
        "app:start": "pnpm --filter tesler-app run start",
        "app:ios": "pnpm --filter tesler-app run ios",
        "app:android": "pnpm --filter tesler-app run android"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=11.0.0"
    }
}